# ============================================================
#  Meteora 全池扫描与筛选器 - 环境变量示例
#  复制本文件为 .env 并填写真实值。.env 不会被提交到 Git。
# ============================================================

# 飞书自定义机器人 Webhook 地址（必填，用于报警）
# 获取方式：飞书群 -> 设置 -> 群机器人 -> 添加自定义机器人 -> 复制 Webhook 地址
FEISHU_WEBHOOK_URL=

# 飞书机器人签名密钥（可选；若机器人开启了“签名校验”则必填）
FEISHU_WEBHOOK_SECRET=

# CoinGecko API Key（可选；页面⑨ 价格区间计算的数据源）
# 填写后自动切换到 https://pro-api.coingecko.com/api/v3（限频更宽松），
# 留空则使用公共域名 https://api.coingecko.com/api/v3（限频较严，429 会自动退避重试）。
COINGECKO_API_KEY=

# DEX Paprika API Key（可选但强烈建议；页面⑨ 池级 K 线数据源）
# 免费注册：https://console.dexpaprika.com （免费、无需绑卡）
# 注册后解锁：10m/15m/30m 粒度 + 最近 7 天回看；无 Key 仅支持 1h 及以上、最近 24 小时。
DEXPAPRIKA_API_KEY=
DEXPAPRIKA_BASE_URL=https://api.dexpaprika.com

# ---- API 基础地址（一般无需修改，均为官方地址）----
METEORA_DLMM_BASE_URL=https://dlmm.datapi.meteora.ag
METEORA_DAMM_BASE_URL=https://damm-api.meteora.ag
JUPITER_BASE_URL=https://lite-api.jup.ag

# ---- 网络参数 ----
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=4

# ---- 限频（官方文档规定：DLMM 30 RPS，DAMM v1 10 RPS；此处保守取值）----
DLMM_RPS=25
DAMM_RPS=8
JUPITER_RPS=3
COINGECKO_RPS=5
DEXPAPRIKA_RPS=10

# ---- 分页大小（已验证的上限：DLMM<=1000，DAMM v1<=300）----
DLMM_PAGE_SIZE=1000
DAMM_PAGE_SIZE=300

# ---- SQLite 数据库路径（相对项目根目录或绝对路径）----
DB_PATH=data/meteora.db
